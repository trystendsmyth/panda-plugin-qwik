{
  "name": "panda-plugin-qwik",
  "version": "0.0.0",
  "description": "Panda CSS v2 plugin that generates Qwik JSX pattern components (Box, Stack, VStack, HStack, …) with full style-prop support.",
  "keywords": [
    "pandacss",
    "panda-plugin",
    "qwik",
    "css-in-js",
    "jsx",
    "patterns"
  ],
  "homepage": "https://github.com/trystendsmyth/panda-plugin-qwik#readme",
  "bugs": "https://github.com/trystendsmyth/panda-plugin-qwik/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trystendsmyth/panda-plugin-qwik.git"
  },
  "license": "MIT",
  "author": "Tristan Smith <trystendsmyth@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "check-exports": "pnpm build && publint && attw --pack . --profile esm-only && node scripts/smoke-dist.mjs",
    "clean": "rimraf dist test/.generated",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "lint": "eslint . --cache",
    "release": "pnpm build && changeset publish",
    "test": "vitest run",
    "test:types": "tsx test/types/run.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:types && pnpm check-exports"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@builder.io/qwik": "1.20.2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@pandacss/dev": "2.2.0",
    "@pandacss/preset-base": "2.2.0",
    "@pandacss/preset-panda": "2.2.0",
    "@pandacss/types": "2.2.0",
    "@pandacss/vite": "2.2.0",
    "@qwik.dev/core": "2.0.0-rc.3",
    "@types/node": "^24.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-5.9": "npm:typescript@~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@pandacss/dev": ">=2.2.0 <3",
    "@qwik.dev/core": "^2.0.0-rc.3"
  },
  "peerDependenciesMeta": {
    "@builder.io/qwik": {
      "optional": true
    },
    "@qwik.dev/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
